# Public values are embedded by `next build`; never place secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=https://phone-sticker-sponsorship.example.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare deploy automation
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Dodo Payments (optional until checkout is enabled)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID=

# PostHog server-side visit counter (optional)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com

# Optional authorization for GET /api/cron/visits
CRON_SECRET=
